[
    {
        "id": "basic-template",
        "name": "基础简洁风",
        "html": "<div class='resume' style='font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto; padding: 20px;'><h1 style='color: #333; text-align: center;'>{{name}}</h1><p style='text-align: center; color: #666;'>电话：{{phone}} | 邮箱：{{email}}</p><hr style='margin: 20px 0;'><div style='line-height: 1.6;'>{{content}}</div></div>",
        "preview": "https://example.com/basic-template.png"
    },
    {
        "id": "modern-template",
        "name": "现代科技风",
        "html": "<!DOCTYPE html><html lang='zh-CN'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1.0'><title>{{name}} - 个人简历</title><style>* {margin: 0; padding: 0; box-sizing: border-box; font-family: 'Arial', 'Microsoft YaHei', sans-serif;} body {background-color: #f5f5f5; color: #333; line-height: 1.6;} .resume-container {max-width: 800px; margin: 30px auto; background-color: white; box-shadow: 0 0 20px rgba(0, 0, 0, 0.1); border-radius: 8px; overflow: hidden;} .resume-header {background-color: #4a90e2; color: white; padding: 30px; text-align: center;} .resume-header h1 {font-size: 32px; margin-bottom: 10px;} .contact-info {display: flex; justify-content: center; gap: 20px; margin-top: 15px;} .contact-item {display: flex; align-items: center; gap: 5px;} .resume-content {padding: 30px;} .section {margin-bottom: 25px;} .section-title {font-size: 22px; color: #4a90e2; border-bottom: 2px solid #4a90e2; padding-bottom: 5px; margin-bottom: 15px;} .section-content {padding-left: 15px;} ul {list-style-type: disc; padding-left: 20px;} li {margin-bottom: 5px;} h3 {margin-top: 15px; margin-bottom: 5px; color: #555;} @media print {body {background-color: white;} .resume-container {box-shadow: none; margin: 0; max-width: 100%;}}</style></head><body><div class='resume-container'><div class='resume-header'><h1>{{name}}</h1><h2>{{position}}</h2><div class='contact-info'><div class='contact-item'><span>📱</span><span>{{phone}}</span></div><div class='contact-item'><span>📧</span><span>{{email}}</span></div></div></div><div class='resume-content'>{{content}}</div></div></body></html>",
        "preview": "https://example.com/modern-template.png"
    },
    {
        "id": "professional-template",
        "name": "专业商务风",
        "html": "<!DOCTYPE html><html lang='zh-CN'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1.0'><title>{{name}} - 个人简历</title><style>* {margin: 0; padding: 0; box-sizing: border-box; font-family: 'Times New Roman', 'SimSun', serif;} body {background-color: #f9f9f9; color: #333; line-height: 1.6;} .resume-container {max-width: 800px; margin: 30px auto; background-color: white; box-shadow: 0 0 15px rgba(0, 0, 0, 0.05); border: 1px solid #eee;} .resume-header {padding: 40px; border-bottom: 2px solid #333; text-align: center;} .resume-header h1 {font-size: 28px; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 2px;} .resume-header h2 {font-size: 18px; color: #777; font-weight: normal; margin-bottom: 15px;} .contact-info {font-size: 14px; color: #555;} .resume-content {padding: 40px;} h3 {font-size: 20px; margin-top: 25px; margin-bottom: 15px; border-bottom: 1px solid #ddd; padding-bottom: 5px;} ul {list-style-type: square; padding-left: 20px; margin-bottom: 20px;} li {margin-bottom: 8px;} .footer {text-align: center; font-size: 12px; color: #999; padding: 20px; border-top: 1px solid #eee;} @media print {body {background-color: white;} .resume-container {box-shadow: none; border: none;}}</style></head><body><div class='resume-container'><div class='resume-header'><h1>{{name}}</h1><h2>{{position}}</h2><div class='contact-info'>{{phone}} | {{email}}</div></div><div class='resume-content'>{{content}}</div><div class='footer'>此简历由AI简历生成器生成 - 更新于 {{date}}</div></div></body></html>".replace('{{date}}', new Date().toLocaleDateString('zh-CN')),
        "preview": "https://example.com/professional-template.png"
    }
]
